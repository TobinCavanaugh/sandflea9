build obj/src_util_util_str.o: compile_c src/util/util_str.c
build obj/src_util_util_cmd.o: compile_c src/util/util_cmd.c
build obj/src_util_str_slice.o: compile_c src/util/str_slice.c
build obj/src_kernel_wasm3-0.5.0_source_m3_api_libc.o: compile_c src/kernel/wasm3-0.5.0/source/m3_api_libc.c
build obj/src_kernel_wasm3-0.5.0_source_m3_api_meta_wasi.o: compile_c src/kernel/wasm3-0.5.0/source/m3_api_meta_wasi.c
build obj/src_kernel_wasm3-0.5.0_source_m3_api_tracer.o: compile_c src/kernel/wasm3-0.5.0/source/m3_api_tracer.c
