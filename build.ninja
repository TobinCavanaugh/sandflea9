build obj/src_kernel_main.o: compile_c src/kernel/main.c
build obj/src_kernel_wasm_spawn.o: compile_c src/kernel/wasm_spawn.c
build obj/src_kernel_wat2wasm_wrapper.o: compile_c src/kernel/wat2wasm_wrapper.c
build obj/src_external_wasm-rt-impl.o: compile_c src/external/wasm-rt-impl.c
build obj/src_external_wasm2c_wat2wasm.o: compile_c_wasm2c src/external/wasm2c_wat2wasm.c
build obj/src_external_xxhash_xxhash.o: compile_c src/external/xxhash/xxhash.c
build obj/src_kernel_xhci_kern_xhci.o: compile_c src/kernel/xhci/kern_xhci.c
