build obj/src_kernel_kern_keyboard.o: compile_c src/kernel/kern_keyboard.c
build obj/src_kernel_kern_mem.o: compile_c src/kernel/kern_mem.c
build obj/src_kernel_kern_mouse.o: compile_c src/kernel/kern_mouse.c
build obj/src_kernel_kern_pci.o: compile_c src/kernel/kern_pci.c
build obj/src_kernel_kern_sched.o: compile_c src/kernel/kern_sched.c
build obj/src_kernel_kern_screen.o: compile_c src/kernel/kern_screen.c
build obj/src_kernel_kern_serial.o: compile_c src/kernel/kern_serial.c
build obj/src_kernel_kern_terminal.o: compile_c src/kernel/kern_terminal.c
build obj/src_kernel_kern_profile.o: compile_c src/kernel/kern_profile.c
