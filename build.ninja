build obj/src_kernel_wasm3-0.5.0_source_m3_exec.o: compile_c src/kernel/wasm3-0.5.0/source/m3_exec.c
build obj/src_kernel_wasm3-0.5.0_source_m3_function.o: compile_c src/kernel/wasm3-0.5.0/source/m3_function.c
build obj/src_kernel_wasm3-0.5.0_source_m3_info.o: compile_c src/kernel/wasm3-0.5.0/source/m3_info.c
build obj/src_kernel_wasm3-0.5.0_source_m3_module.o: compile_c src/kernel/wasm3-0.5.0/source/m3_module.c
build obj/src_kernel_wasm3-0.5.0_source_m3_optimize.o: compile_c src/kernel/wasm3-0.5.0/source/m3_optimize.c
build obj/src_kernel_wasm3-0.5.0_source_m3_parse.o: compile_c src/kernel/wasm3-0.5.0/source/m3_parse.c
build obj/regularfont.o: embed_font src/assets/regularfont.sfn

build iso_root/kernel.elf: link_kernel obj/src_arch_kernel.o obj/src_arch_isrs.o obj/src_kernel_kern_asmstubs.o obj/src_kernel_kern_compositor.o obj/src_kernel_kern_ext2.o obj/src_kernel_kern_fs.o obj/src_kernel_kern_ide.o obj/src_kernel_kern_ipc.o obj/src_kernel_kern_interrupts.o obj/src_kernel_kern_keyboard.o obj/src_kernel_kern_mem.o obj/src_kernel_kern_mouse.o obj/src_kernel_kern_pci.o obj/src_kernel_kern_sched.o obj/src_kernel_kern_screen.o obj/src_kernel_kern_serial.o obj/src_kernel_kern_terminal.o obj/src_kernel_kern_profile.o obj/src_kernel_kern_tests.o obj/src_kernel_quake.o obj/src_kernel_kern_vmm.o obj/src_kernel_libgcc_stubs.o obj/src_kernel_main.o obj/src_kernel_wasm_spawn.o obj/src_kernel_wat2wasm_wrapper.o obj/src_external_wasm-rt-impl.o obj/src_external_wasm2c_wat2wasm.o obj/src_external_xxhash_xxhash.o obj/src_kernel_xhci_kern_xhci.o obj/src_kernel_xhci_kern_xhci_rings.o obj/src_kernel_xhci_kern_usb_hid.o obj/src_kernel_ssfn.o obj/src_kernel_stbsupport.o obj/src_kernel_x64_idt.o obj/src_kernel_x64_apic.o obj/src_util_util_str.o obj/src_util_util_cmd.o obj/src_util_str_slice.o obj/src_kernel_wasm3-0.5.0_source_m3_api_libc.o obj/src_kernel_wasm3-0.5.0_source_m3_api_meta_wasi.o obj/src_kernel_wasm3-0.5.0_source_m3_api_tracer.o obj/src_kernel_wasm3-0.5.0_source_m3_api_uvwasi.o obj/src_kernel_wasm3-0.5.0_source_m3_bind.o obj/src_kernel_wasm3-0.5.0_source_m3_code.o obj/src_kernel_wasm3-0.5.0_source_m3_compile.o obj/src_kernel_wasm3-0.5.0_source_m3_core.o obj/src_kernel_wasm3-0.5.0_source_m3_emit.o obj/src_kernel_wasm3-0.5.0_source_m3_env.o obj/src_kernel_wasm3-0.5.0_source_m3_exec.o obj/src_kernel_wasm3-0.5.0_source_m3_function.o obj/src_kernel_wasm3-0.5.0_source_m3_info.o obj/src_kernel_wasm3-0.5.0_source_m3_module.o obj/src_kernel_wasm3-0.5.0_source_m3_optimize.o obj/src_kernel_wasm3-0.5.0_source_m3_parse.o obj/regularfont.o | link.ld

